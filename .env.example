# RemoteDev Environment Configuration Example

# Backend Service
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=remotedev-jwt-secret-change-this-in-production-random-64-bytes-min
DATABASE_URL=file:./data/remotedev.sqlite

# Supabase / PostgreSQL (Optional, defaults to SQLite for local development)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/remotedev

# Laptop Agent
AGENT_PORT=8765
AGENT_HOST=0.0.0.0
AGENT_NAME="My Windows Laptop"
CLOUD_RELAY_URL=ws://localhost:4000/ws
CLOUD_API_URL=http://localhost:4000/api/v1
PAIRING_SECRET=local-pairing-salt-key-demo

# Android App Settings
# ANDROID_API_URL=http://10.0.2.2:4000/api/v1 (for emulator) or http://<LAPTOP_LAN_IP>:4000/api/v1
# ANDROID_WS_URL=ws://10.0.2.2:4000/ws
